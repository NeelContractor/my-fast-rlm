# Copy to `.env` and fill in the values you need. Never commit real secrets.
# NOTE: this tool does NOT auto-load `.env`. Export it before running:
#   set -a; source .env; set +a

# ── OpenAI-compatible backend (default: OpenRouter) ─────────────────────────
# Required for the default backend. Falls back to OPENAI_API_KEY, then
# OPENROUTER_API_KEY if unset.
RLM_MODEL_API_KEY=
# Any OpenAI-compatible base URL. Defaults to OpenRouter.
RLM_MODEL_BASE_URL=https://openrouter.ai/api/v1

# ── Fallback API keys (optional) ────────────────────────────────────────────
# Used when RLM_MODEL_API_KEY is not set.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ── Native Anthropic backend (optional) ─────────────────────────────────────
# Selected by a `claude-*` or `anthropic/*` model name. RLM_ANTHROPIC_API_KEY
# takes precedence over ANTHROPIC_API_KEY when both are set.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# RLM_ANTHROPIC_API_KEY=
# RLM_ANTHROPIC_BASE_URL=

# ── Vertex AI (optional; Application Default Credentials, no static key) ────
# Selected by a `vertex/` model prefix or RLM_VERTEX_AI=1.
# RLM_VERTEX_AI=1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS=
# CLOUDSDK_CORE_PROJECT=

# ── Optional runtime settings ───────────────────────────────────────────────
# Select the rlm_config.yaml preset: "free" (OpenRouter free models only) or
# "standard" (paid-capable defaults). Unset uses the `profile:` key in yaml.
# Must be exported to take effect (see the note at the top of this file).
# RLM_PROFILE=free
# Override the directory for user-level state (default: ~/.fast_rlm).
# FAST_RLM_HOME=

# ── Example scripts only (not needed by the library) ────────────────────────
# EXA_API_KEY=
# RLM_DEMO_MODEL=
# VAULT_KEY=
# VAULT_PEPPER=
